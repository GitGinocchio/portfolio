{
  "name": "portfolio",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-07-20",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CURSOR_TRACKER",
        "class_name": "CursorTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CursorTracker"]
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}